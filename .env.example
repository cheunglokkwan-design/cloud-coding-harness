# Copy to .env. Every HARNESS_* setting is documented in orchestrator/harness/config.py.
ANTHROPIC_API_KEY=
# "scripted" runs the demo agent without an API key; "anthropic" uses Claude.
CCH_DEFAULT_PROVIDER=scripted
# Must be a path that exists on the Docker host; it is mounted at the same path in the
# orchestrator and (partly) in sandboxes.
CCH_DATA_DIR=/tmp/cch-data
CCH_WARM_POOL=8
